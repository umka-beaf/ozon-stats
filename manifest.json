{
  "manifest_version": 3,
  "name": "Ozon Stats — Статистика заказов",
  "version": "1.0.0",
  "description": "Показывает общую сумму потраченных денег, количество заказов и дату регистрации на Ozon.ru",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "*://*.ozon.ru/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ozon Stats",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.ozon.ru/*"],
      "exclude_matches": ["*://seller.ozon.ru/*", "*://job.ozon.ru/*"],
      "css": ["content/styles.css"],
      "js": [
        "content/dark-fixes.js",
        "content/panel.js",
        "content/utils.js",
        "content/orders-panel.js",
        "content/full-stats.js",
        "content/bootstrap.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
